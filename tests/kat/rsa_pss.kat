# Подпись редактировавшего устройства — RSA-PSS-SHA256, docs/format.md,
# раздел «ВЕРСИЯ 3 ОТКРЫТА», п. 7.
#
#   схема   = RSASSA-PSS (RFC 8017 §8.1)
#   хеш     = SHA-256, маска MGF1-SHA256
#   соль    = 32 байта
#   модуль  = RSA-2048
#   показатель = 65537
#
# ОТКУДА ВЗЯТ. Снят с ЖИВОГО TPM машины разработки 2026-08-29
# (`spikes/rsa-pss-tpm/spike-rsa-pss.ps1`, Microsoft Platform Crypto Provider).
# Не выдуман, не взят из документации и не вычислен нашим же кодом — в этом весь
# смысл: проверяющий сверяется с тем, что производит НАСТОЯЩЕЕ железо, а не сам
# с собой.
#
# Заново из спецификации не выводится: приватный ключ остался в TPM и удалён.
# Перевыпуск возможен только новым прогоном спайка на машине с TPM, и это будет
# ДРУГОЙ вектор — соль PSS случайна, двадцать подписей одного сообщения
# различны.
#
# ЧТО ОН ДОКАЗЫВАЕТ. Что наш чистый проверяющий (`oc-crypto/src/rsa.rs`)
# принимает подпись, сделанную независимой реализацией. Обратное — что он
# отвергает порчу — вектором не доказывается и проверяется отдельными пробами
# рядом с кодом.
#
# ПРАВИЛО ИЗМЕНЕНИЯ — общее для каталога, см. README.md: вектор меняется только
# вместе с решением в docs/format.md и подъёмом версии формата.

# Модуль открытого ключа, big-endian, 256 байт.
modulus = 

# Показатель. Прибит в коде и здесь выписан ради полноты вектора.
exponent = 010001

# Подписанное сообщение: "SS/v1/editor-signature spike message".
#
# Метка ЗДЕСЬ ОСТАЁТСЯ ПРЕЖНЕЙ, и это не пропущенное переименование.
# Подпись снята с живого TPM 2026-09-08 и перевыпуску не подлежит: ключ
# внутри модуля, приватная часть не экспортируется, повторить подпись под
# новой меткой нечем. Вектор доказывает, что наша проверка RSA-PSS сходится
# с настоящим аппаратным подписантом, — утверждение о МЕХАНИЗМЕ, а не о
# метке; байты сообщения тут произвольны и в формат не входят.
message = 53532f76312f656469746f722d7369676e6174757265207370696b65206d657373616765

# Подпись, 256 байт.
signature = 
