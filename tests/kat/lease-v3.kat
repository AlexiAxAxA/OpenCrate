# Лизинг ВЕРСИИ 3: тело, подпись и ключ проверки — docs/protocol.md §2.3, §9.11.1.
#
# ЗАМОРОЖЕНО вместе с выпуском документа лизинга версии 3 (2026-09-16, B6b).
#
# Отдельный файл по той же причине, что lease-v2.kat: lease.kat и lease-v2.kat
# заморожены вместе со своими документами (И-14). Версия 3 несёт тег 13 —
# аттестацию ключа устройства, признанную сервером; документ без признака
# по-прежнему выпускается версией 1 или 2 и сходится со старыми векторами.
#
# Проверяется тестом crates/oc-format/tests/lease_attestation.rs.
#
# ## Вход
#
#   приватный ключ сервера = 5a × 32 (не выписан)
#   поля — как у lease-v2.kat, без профиля сервера; аттестация признана по
#   закреплённому EK (основание 2).
lease_verify_key = 0d7550754e0800a5d237eef5826035766b9b3e5a15868a940ab289958788e3b0

# ТЕЛО. Раскладка по полям:
#   0100 02000000 0300                версия = 3
#   0200 … 0b00                       как в lease-v2.kat, до часов TPM включительно
#   0d00 01000000 02                  аттестация: закреплённый EK
lease_body = 

# ПОДПИСЬ. Ed25519 над транскриптом "CC/v1/lease" ‖ 0x00 ‖ поле(тело); метка та же,
# что у версий 1 и 2.
lease_signature = 6db034cfa2bb52c01f6403dc14f66e8ea64ab4cbe31db8c668364776a6d27a17be71d7b9ebaaef7ad983f31ef4b6e5e6e9b21552a1863565a4582e5d646eb500
