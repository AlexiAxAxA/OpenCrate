# Лиза ДЕЙСТВИЯ: тело, ключ проверки и подпись сервера —
# docs/agent-protocol/stage-2-actions.md §4.3.
#
# ЗАМОРОЖЕНО вместе с выпуском документа Agent Protocol этапа 2. Версии
# КОНТЕЙНЕРА вектор не касается. Проверяется тестом
# crates/oc-protocol/tests/action_vectors.rs.
#
# ## Зачем вектор на лизу отдельно от гранта
#
# Потому что ключ подписи у сервера ОДИН И ТОТ ЖЕ на лизинг файла и на лизу
# действия — `authority.lease_verify_key` из заголовка, закреплённый подписью
# автора. Домены разводит только метка, и этот вектор и есть проверка того, что
# она на месте: подпись, снятая в домене гранта, с замороженной не совпадёт.
#
# ## Ключи
#
#   приватный ключ подписи лиз = 5e x 32 (не выписан: это ключ)
lease_verify_key = 8146640f02493af4fbc54fe33388e75dc2c937ae0b7727cc2b2afb1b75199a3e

# ТЕЛО. TLV, теги строго по возрастанию (И-7), длины точные (И-8). По полям:
#
#   0100 10000000 67x16                имя файлового гранта
#   0200 20000000 d1x32                отпечаток двери, которой выдана лиза. У
#                                      X25519 отпечаток И ЕСТЬ ключ (K27)
#   0300 02000000 0100                 вид действия: 1 = git.push
#   0400 1c000000 <аргументы>           аргументы ДОСЛОВНО, см. ниже
#   0500 10000000 5ax16                nonce двери: им сервер отличает повтор от
#                                      нового исполнения, и второй раз по тому
#                                      же значению лизы не выдаёт
#   0600 08000000 10185465 00000000    issued_at  = 1700010000
#   0700 08000000 2e185465 00000000    expires_at = 1700010030 — ровно
#                                      ACTION_LEASE_SECONDS = 30 секунд. Окно
#                                      проверяется НА РАЗБОРЕ: лиза, объявившая
#                                      неделю, отвергается границей крейта, а не
#                                      доброй волей двери
#   0800 08000000 0700000000000000     seq = 7, номер записи журнала
#
# АРГУМЕНТЫ (тег 4) — теми же номерами, что ограничители гранта:
#
#        0100 06000000 "origin"        remote
#        0200 0a000000 "agent/work"    branch
#
# Дверь исполняет ТО, ЧТО В ЛИЗЕ, а не то, что просила, и сверяет равенство
# одного с другим: иначе «лиза на другие аргументы» была бы неотличима от
# «сервер согласился».
lease_body = 

# ПОДПИСЬ. Ed25519 над транскриптом "CC/v1/action-lease" ‖ 0x00 ‖ поле(тело).
#
# Проверяется ключом lease_verify_key ДО разбора тела (И-5, И-6). Для гранта без
# единого файла ключ берётся из ответа FetchChain — заголовка, из которого его
# можно достать, у такой двери нет.
lease_signature = 4685f047bbea5b6fd3b826710a814e63c3a4cbe9818ab986e83134372eb62f3de46572a9d953386e3c23ff73d6899bd920d389bf95c26bf1d0f777f6945a5002
