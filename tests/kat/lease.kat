# Лизинг: тело, подпись и ключ проверки — docs/protocol.md §2.
#
# ЗАМОРОЖЕНО вместе с выпуском документа лизинга версии 1. Лизинг имеет СВОЮ
# версию, независимую от версии контейнера: документы меняются в разном темпе, и
# смешивать их значило бы поднимать версию контейнера ради поля разрешения.
#
# Проверяется тестом crates/oc-format/tests/lease_signature.rs.
#
# ## Почему подпись заморожена, а не только тело
#
# Тело само по себе ничего не значит: лизинг — это утверждение СЕРВЕРА, и без
# подписи он лист бумаги. Заморозив только байты тела, мы оставили бы на свободе
# транскрипт — то, ЧТО именно подписано, — а расхождение там молчаливо: подпись
# просто не сойдётся, и выглядеть это будет как «сервер сломался».
#
# ## Вход
#
#   приватный ключ сервера = 5a × 32 (не выписан: это ключ, а не значение на проводе)
lease_verify_key = 0d7550754e0800a5d237eef5826035766b9b3e5a15868a940ab289958788e3b0

# ТЕЛО. TLV, теги строго по возрастанию, разбор по §2. Раскладка по полям:
#   0100 02000000 0100                версия = 1
#   0200 10000000 11×16               file_id
#   0300 20000000 22×32               отпечаток устройства
#   0400 20000000 33×32               policy_hash
#   0500 08000000 0700000000000000     seq = 7
#   0600 08000000 0200000000000000     epoch = 2
#   0700 08000000 00f1536500000000     issued_at = 1700000000
#   0800 08000000 8042556500000000     expires_at = 1700086400
#   0900 01000000 01                   состояние = действует
#   0a00 04000000 05000000             остаток открытий = 5
#   0b00 0c000000 03000000 40e2010000000000   часы TPM: сброс 3, 123456 мс
#
# Поле 0a пишется ВСЕГДА, в том числе пустым: пустое значение означает «сервер
# лимита не ставил», отсутствие поля — что о его воле не известно ничего. То же
# различие, что у max_opens в §4 формата, и по той же причине.
lease_body = 

# ПОДПИСЬ. Ed25519 над транскриптом "CC/v1/lease" ‖ 0x00 ‖ поле(тело).
#
# Метка беспрефиксна: соседний кеш назван "CC/v1/cached-lease" именно затем,
# чтобы "CC/v1/lease-cache" не оказался расширением этой метки (И-12).
#
# Проверка — verify_strict, как и у заголовка (И-6): иначе наследуется
# malleability подписи и теряется «одна подпись — один документ».
lease_signature = 41a9f337dba76017b29b83b7ecd41db1a50939f3d65a1f8e0b040027a3202118c223941d001aa632061a24f9d47b6f3abd4bc851e1d9d561ca0ca47a9c2f3e02
