# Заголовок целиком, core_hash и изменяемая область — docs/format.md §1, §1.2, §3.2.
#
# ЗАМОРОЖЕНО, см. derivations.kat. Проверяется crates/oc-format/tests/kat_policy.rs.
#
# Оба значения были долгом с самого появления векторов (см. README) и закрыты перед
# заморозкой версии 1.
#
# ВХОД — заголовок из фиксированных величин; политика та же, что в policy.kat:
#   file_id     = 11 × 16      author_key   = 01 × 32
#   header_salt = 21 × 32      original_root = 33 × 32
#   org_id      = "acme"       class = 0    key_slots = пусто
#   wrapped_cek = bb × 72      private_meta = aa × 64

# Байты заголовка целиком, без Magic и без HeaderLen: ровно то, что подписывается и
# по чему считается core_hash.
#
# Заморожены ВМЕСТЕ с хешем намеренно. Хеш считается по байтовому диапазону, а не по
# повторной кодировке разобранной структуры (§5), поэтому вектор без самих байт
# проверял бы половину утверждения: вторая реализация не смогла бы понять, разошлась
# она в хеше или в кодировании заголовка.
header_bytes = 

# core_hash = SHA-256( "CC/v1/core-hash" ‖ 0x00 ‖ Header БЕЗ записей 10 и 17 )
#
# Вырезаются ЗАПИСИ ЦЕЛИКОМ — тег, длина и значение. Конвенция обратна policy_hash
# (§4.0), где хешируется только значение; это то место, где вторая реализация
# ошибётся, рассуждая по аналогии. В этом векторе слоты (тег 10) пусты, а
# wrapped_cek (тег 17) заполнен — то есть вырезание видно: изменение любого байта
# wrapped_cek хеш не меняет.
core_hash = b389f15fc7f3b618531d0e511684e33dd12c959d1828d468bf9baac9d1f92071

# Изменяемая область целиком: ContentDescLen(4) ‖ тело ‖ MAC(32).
#
# ВХОД: ключ MAC = 6c × 32 (подан прямо, а не выведен из CEK: K6 уже заморожен в
# derivations.kat), file_id = 11 × 16, и поля
#   total_len = 5000000, chunk_count = 77, tree_root = ab × 32,
#   version_counter = 0, footer_offset отсутствует.
# Числа согласованы по §6.1: 77 = ⌈5000000 / 65536⌉.
#
# Заморожена в собранном виде — ровно то, что лежит в файле. Именно про эти 32 байта
# MAC §1.2 предупреждает, что арифметика без них промахивается.
content_desc = 4c000000010008000000404b4c00000000000200040000004d000000030020000000abababababababababababababababababababababababababababababababab0400080000000000000000000000670f7c95377e41442fe52ce93e0fdba54d941e4f4dffb6bd3287e973aca6569c
