# Дерево целостности — docs/format.md §6.3.
#
# ЗАМОРОЖЕНО, см. derivations.kat.
#
#   leaf_i = H(0x00 ‖ "CC/v1/leaf" ‖ u32be(i) ‖ u64be(len(ct_i)) ‖ nonce_i ‖ tag_i ‖ ct_i)
#   node   = H(0x01 ‖ "CC/v1/node" ‖ left ‖ right)
#   apex   = MTH по RFC 6962 (нечётный узел продвигается, не дублируется)
#   root   = H(0x02 ‖ "CC/v1/node" ‖ u32be(leaf_count) ‖ apex)
#
# ПЕРЕВЫПУЩЕНО 2026-08-17 вместе с решением Р-1 (docs/format.md §6.3): в прообраз
# листа добавлены длина и сам ШИФРОТЕКСТ чанка. До этой правки лист связывал только
# nonce и тег, и подписанный автором original_root не зависел ни от одного байта
# содержимого: тег Poly1305 не стоек к коллизиям под известным ключом, поэтому
# владелец CEK переписывал чанк, сохраняя тег, лист и корень. Прежние значения
# сохранены в истории git и намеренно не приводятся здесь — вектор должен
# показывать, чему обязано быть равно значение сейчас, а не чему оно равнялось.
#
# Наружу — в подписанный original_root и в tree_root под MAC — идёт ROOT, а не
# APEX. Оба записаны здесь намеренно: apex сверяется с эталонной реализацией
# RFC 6962, root добавляет к нему связку с числом листьев, без которой одно и то
# же доказательство подтверждало бы разные места в деревьях разного размера.

# Одиночные величины. Входные данные: nonce = 01 × 24, tag = 02 × 16, ct = 03 × 33.
#
# Длина шифротекста 33 байта выбрана не круглой намеренно: она входит в прообраз как
# u64be, и вектор на некруглой длине ловит подмену ширины этого поля.
leaf_index_0 = 3b14507fa1ec385e3a3a0673b84028b0401a133f32c6a9381a3d56129f3c8e8e
leaf_index_7 = 2805cc807542c98f097fdfdeed5d1a70517976088780039455e4385506b58069
node = 25e09b5f306190ae5d47a77446d95a005726200ffba4fadcfd31be9e3248deca
root_of_single = 02108c7aa50393f64c374032b398b367e3c1155c4e1c425eea1a40002d70fa01

# Деревья целиком. Лист i строится детерминированно: seed = BLAKE3(u32be(i)),
# nonce = seed[0..24], tag = seed[8..24], ct = seed (все 32 байта).
#
# Размеры 1, 2, 3 и 5 выбраны не произвольно: 1 — вырожденный случай (root
# считается от одного листа), 2 — полная пара без продвижения, 3 — одно
# продвижение, 5 — продвижение на нескольких уровнях сразу (5 → 3 → 2 → 1).
apex_1_leaves = 573db17512912a136a14a54ee43bb995931798f6951214e028287ffd431c90f2
root_1_leaves = 49b6b892c814218d6d74bb70a4ddd1035d4b2c251e6575bc32a3a8b73cbab4bd
apex_2_leaves = 52518858434d8faeb7920ee040d52c933d9d39a0ba40d39f0d88561f5a631131
root_2_leaves = 21e93bece823289a30998ecd51763d6510b474be657716b3fbb764e4a7e3e061
apex_3_leaves = 33fa2e4246427cc649d4565bd65f2ec06ae4915b0b7fb01ec69c3b4b776d0833
root_3_leaves = 2b43835e384b7e71575a77fc288b552cdfded22b2b030ca42e4b5ffc64e747e5
apex_5_leaves = de3a6a0146a0248ddbb8ef59545b0f8ff9ef62cee42374c44c5dd8cdec34b553
root_5_leaves = c80bad2c5ebc87a3a6b17342a2cf55a487473a3a6c75aaf932da8ce0023c44e8
