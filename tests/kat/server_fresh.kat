# Свежее значение сервера — docs/format.md, раздел «СВЕЖЕСТЬ СЕРВЕРА ВЫВОДИТСЯ
# 2026-09-20», производная K30 (§3.5).
#
# ЗАМОРОЖЕНО 2026-09-20 тем же решением. Новым файлом, а не строками в
# derivations_wire.kat: И-14 запрещает менять замороженное, не заводить новое.
#
# Вычислено НЕЗАВИСИМО от Rust — отдельным сценарием на hashlib/hmac по спеке
# (SHA-256 прообраза и HKDF-Expand RFC 5869 руками), и только потом сверено с
# `oc_crypto::kdf::server_fresh`. Сверяется в crates/oc-crypto/tests/kat.rs,
# причём дважды: транскриптом, собранным в самой пробе, и функцией крейта.
#
#   prk  = SHA-256("CC/v1/server-fresh" ‖ 0x00 ‖ seed(32) ‖ u8(kind) ‖
#                  i64be(now) ‖ device_fpr(32))
#   K30  = HKDF-Expand(prk, info = "CC/v1/server-fresh", L)
#
# Назначения (kind): 1 — вызов аттестации (docs/protocol.md §9.11.1),
# 2 — секрет доказательства владения (§9.4). Длина L у второго — 32 байта на
# каждый предъявленный ключ; счётчик внутри Expand разводит половины, поэтому
# 96-байтовый секрет начинается ровно теми же 32 байтами, что и 32-байтовый.
# Это свойство здесь ЗАФИКСИРОВАНО, а не подмечено: на нём держится то, что
# число половин не меняет первую.
#
# Входы (фиксированы навсегда):
#   seed       = 3e × 32
#   device_fpr = 5f × 32
#   now        = 1789862400 (2026-09-20T00:00:00Z), и соседняя секунда для
#                контроля: время обязано разводить значения при ТОМ ЖЕ засеве —
#                ради этого производная и заведена (И-1, довод С-13).

seed = 3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e3e
device_fpr = 5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f
prk_attest = 4cd0eb57951b220cb696a9682f6d7a3798c9976eb641230b20944166930a6780
k30_attest_nonce = ab11e3c0bf903ec15a534e1e5686bbba194ec72d2d017afbe98ae52887056c54
k30_attest_nonce_next_second = 6c515f83d9713d5327f372478ddf7ea69e446efea924b74da012cb9636cf55ea
k30_proof_secret_32 = 3f94806870aa7e78780c1a6755afcabd808b646fdf44bb0eb935df3bd9831c36
k30_proof_secret_96 = 3f94806870aa7e78780c1a6755afcabd808b646fdf44bb0eb935df3bd9831c36b8d8e2defe95603887b29e14c1ff725cbb3b7385383fdf01c2773c5e546c70bf3ff932092ab0246942923293de1d0c090faf5f96909cbdef67f6e1fcf018a4e0
