# Политика: её байты на проводе и policy_hash — docs/format.md §4 и §4.0.
#
# ЗАМОРОЖЕНО, см. derivations.kat.
#
# Проверяется тестом crates/oc-format/tests/kat_policy.rs. Добавлено вторым раундом
# ревью (пункты Р-8 и Р-10): до него байтовая раскладка вариантов политики и
# транскрипт её хеша жили ТОЛЬКО в коде, хотя §4 объявляет свои номера нормативными,
# а policy_hash — межреализационная поверхность (сервер сверяет его при выдаче
# лизинга). Собрать те же байты по документу было нельзя.
#
# ВХОД — политика со всеми нетривиальными ветками кодирования разом:
#   actions:      разрешён только View (тег 1); остальные пять записаны как Deny
#   validity:     Window{not_before = 1700000000, not_after = 1800000000}
#   network:      Lease{seconds = 28800, max_offline_seconds = 3600}
#   min_binding:  Hardware  (байт 2 — нумерация с ЕДИНИЦЫ, см. §4)
#   max_opens:    Some(5)
#   watermark:    true
#
# Разбор этой строки вручную — хорошая проверка понимания §4:
#   0100 2a000000 ...   тег 1 (actions), длина 42, вложенный TLV из шести записей
#   0200 11000000 02 ...  тег 2 (validity), длина 17, вид 0x02 = Window, два i64le
#   0300 11000000 02 ...  тег 3 (network), длина 17, вид 0x02 = Lease, два i64le
#   0400 01000000 02      тег 4 (min_binding), длина 1, значение 2 = Hardware
#   0500 04000000 05000000  тег 5 (max_opens), длина 4, u32le = 5
#   0600 01000000 01      тег 6 (watermark), длина 1, флаг
policy_value = 01002a0000000100010000000102000100000000030001000000000400010000000005000100000000060001000000000200110000000200f153650000000000d2496b00000000030011000000028070000000000000100e000000000000040001000000020500040000000500000006000100000001

# policy_hash = SHA-256( "CC/v1/policy-hash" ‖ 0x00 ‖ policy_value )
#
# Хешируется ТОЛЬКО значение записи: шесть байт префикса (тег u16le, длина u32le) в
# хеш не входят. Конвенция ОБРАТНА core_hash (§3.2), где записи вырезаются целиком
# вместе с префиксом, — и это ровно то место, где вторая реализация ошибётся, если
# будет рассуждать по аналогии.
policy_hash = a555fd4f5a40faf34f77b4f94aa4de9119aa0ce9d76e60c0cccf0db3dba2ec67
