# Запечатывание слота на P-256 (K10 при kem_id = 2) — docs/format.md §3.3, §3.5.
#
# ЗАМОРОЖЕНО вместе с решением об открытии версии 2 (docs/format.md, раздел
# «ВЕРСИЯ 2 ОТКРЫТА»). Перевыпуск законен только с новым таким решением.
#
# Проверяется тестом crates/oc-crypto/tests/kat.rs.
#
# ## Это K10, а не K11 — и путать их дорого
#
# Слот на P-256 выводится ТОЙ ЖЕ производной, что и слот на X25519: механизм в
# K10 параметризован, `u8(kem_id)` входит в `info`. План Ф-6 обещал «KAT на K11»,
# и это был не тот номер: K11 — другое сообщение, сервер→устройство, с `lease.seq`
# в `info`, и принадлежит оно пути лизингов (Ф-7). Реализуй кто-нибудь K11 вместо
# K10, слот не открылся бы, а выглядело бы это как повреждённый файл.
#
# ## Почему вектор ОТКРЫТИЯ, а не запечатывания
#
# По той же причине, что и у seal.kat: запечатывание случайно по построению —
# эфемерная пара из генератора, nonce из засева (§3.1). Требовать от второй
# реализации тех же байтов значило бы заморозить наш генератор, а не формат.
# Открытие же детерминировано целиком, и именно его выполняет всякий, кто читает
# контейнер.
#
# Одна проверка покрывает всю конструкцию на новом механизме: согласование P-256,
# перевод несжатой точки, вывод K10 вместе с его info, разбор ХРАНИМОГО nonce и
# AEAD со связанными данными.

# ВХОД.
#   приватный ключ получателя = 5e × 32   (big-endian скаляр; тот же, что в seal.kat)
#   file_id                   = 11 × 16
#   aad                       = 9d × 32   (по формату это policy_hash)
#
# Публичный ключ — 65 байт несжатой точки SEC1: 0x04 ‖ X(32) ‖ Y(32). Сжатой формы
# формат не принимает: PCP её не отдаёт, а две формы одного ключа дали бы для
# одного получателя две разные записи слота и разошедшиеся core_hash и подпись.
p256_recipient_public = 04ae2f585e24b77570e31c91082e3c73f4035f1fe4b297444b1a1b94699668e90f3622840fa69e725d3a2be6168a6779ae834b3cf92f866370f0753060418801ad

# info запечатывания: метка назначения ‖ u8(kem_id) ‖ file_id.
#
# Заморожено отдельно, потому что расхождение здесь молчаливо. Разбор строки:
#   53532f76312f736c6f742d617574686f722d646576696365   "CC/v1/slot-author-device" (24 байта)
#   02                                                 kem_id = 2 (P-256+HKDF-SHA256)
#   1111…11                                            file_id (16 байт)
#
# Байт механизма — тот самый, что делает переразметку слота бесполезной: подменив
# kem_id, противник меняет и ключ.
p256_slot_info_device = 43432f76312f736c6f742d617574686f722d6465766963650211111111111111111111111111111111

# БЛОБ. Раскладка записи слота: enc(65) ‖ nonce(24) ‖ ct(шифротекст с тегом).
#
# enc здесь 65 байт, а не 32, — в этом всё отличие версии 2 от версии 1 на проводе.
p256_seal_enc = 043e0fb4b9fa254fa718466911f31f8ffa509d577ed3a51077accf6b9823ad85f4a052f2525ba3da5c3cefa99dda2d1a1f3960c6c644959dc636c8c3c856f9d324
p256_seal_nonce = 604c6ef0512a945c7ca7685a120756aceae1678940f4b5c0
p256_seal_ct = e8f6d8191a80587503b998756f8a9411f794f20cd7c79212c5492de46fbe328495423133d874112cfc9f0d2c2b536271

# ВЫХОД: то, что обязано получиться при открытии.
p256_seal_plaintext = a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1
