# Тождество операции на проводе — docs/protocol.md §9.10, K28 (docs/format.md §3.5).
#
# ЗАМОРОЖЕНО 2026-09-15 решением «Тождество операции». Новым файлом, а не строками
# в derivations_wire.kat: И-14 запрещает менять замороженное, не заводить новое.
#
# Вычислено НЕЗАВИСИМО от Rust — по спеке, отдельным сценарием (SHA-256 и TLV
# «тег u16le ‖ длина u32le ‖ значение» руками), и сверяется тремя тестами:
#   crates/oc-crypto/tests/kat.rs    — K28 по спеке и функцией oc_crypto::kdf::operation_id;
#   crates/oc-format/tests/kat_operation.rs — байты запроса с тегом 9 и ответов с эхом
#                                      (теги 3 выдачи и 2 отказа) разбором и кодированием;
#   crates/cc-cli/tests/kat_wire.rs  — тождество, выведенное КЛИЕНТОМ его функцией.
#
# K28 = SHA-256("CC/v1/operation-id" ‖ 0x00 ‖ seed(32) ‖ u8(kind) ‖ тело без тега 9).
# Вид входит в засев: у активации (3) и продления (22) тело одно, и один засев
# без вида дал бы одно тождество двум операциям — второй вектор это стережёт.
#
# Входы (фиксированы навсегда):
#   seed          = 42 × 32
#   тело запроса активации — TLV по возрастанию тегов:
#     1 file_id 11 × 16; 2 policy_hash 22 × 32; 3 device_fpr 33 × 32; 4 kem 01;
#     5 device_public 33 × 32; 6 слот = u32le(32) ‖ 55 × 32 ‖ 66 × 24 ‖ u32le(48) ‖ 77 × 48;
#     7 lease_seconds = 28800 (i64le); 8 часы = u32le 7 ‖ u64le 900000 ‖ i64le 1924992000
#   request_digest = SHA-256(u8(kind) ‖ тело С тегом 9) — хеш, по которому сервер
#   отличает повтор от другого запроса под тем же тождеством (без MAC сессии:
#   MAC у каждого разговора свой, тело — одно).
#   выдача: доля a1 × 40, лизинг b2 × 120, эхо = k28_operation_id
#   отказ: текст UTF-8 «повтор: исход тот же», эхо = k28_operation_id

seed = 4242424242424242424242424242424242424242424242424242424242424242
activate_body_without_id = 
k28_operation_id = 579df594dd7199fe55ac8b27838f11162a4bfb80f47f02354af18e929de0cf69
k28_renew_operation_id = 4df2ec8e331e139cf1940eaa6d30da1a4364094026234b28dbbd639ff7e30fa5
activate_request_with_id = 
request_digest = 82db28331ec41c4cf0dd702ab4ce453ecf66d6a61d0af006389af91c6a36b24a
granted_with_echo = 
deny_text = d0bfd0bed0b2d182d0bed1803a20d0b8d181d185d0bed0b420d182d0bed18220d0b6d0b5
denied_with_echo = 07010024000000d0bfd0bed0b2d182d0bed1803a20d0b8d181d185d0bed0b420d182d0bed18220d0b6d0b5020020000000579df594dd7199fe55ac8b27838f11162a4bfb80f47f02354af18e929de0cf69
