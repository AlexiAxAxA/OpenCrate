# Производные провода — docs/format.md §3.5: K11, K12, K21, K22, K23, K24, K25, K27.
#
# Строка выше называла четыре производные при семи в файле, и это ровно тот
# дефект, о котором предупреждает README каталога: индекс, отставший от
# каталога, молчит именно о том векторе, о существовании которого сверяющийся не
# знал. Исправлено 2026-09-09; значения не тронуты.
#
# K25 замораживает не только само значение, но и КОНВЕРТ запроса: под MAC идёт
# `u8(kind) ‖ закодированное тело`, а сам MAC(32) ложится хвостом за телом.
# Номер вида входит в вектор — `seal_request` отказывается заверять тело, чей
# первый байт не Activate и не Renew, поэтому смена номера роняет проверку.
#
# ЗАМОРОЖЕНО 2026-09-06 по итогу криптообзора (остаток «производные без вектора»),
# см. правило изменения в derivations.kat. Добавление, а не перевыпуск: И-14
# запрещает менять замороженное, не заводить новое.
#
# Проверяется ТРЕМЯ тестами, и это существенно:
#   crates/oc-crypto/tests/kat.rs         — открытие блобов и сами производные;
#                                           info собран ПО СПЕКЕ, а не кодом сервера;
#   crates/cc-authority/tests/kat_journal.rs — сервер собирает info доли A СВОЕЙ
#                                           функцией и сверяется с той же строкой;
#   crates/cc-cli/tests/kat_wire.rs       — клиент собирает info доли B своей.
# Две реализации одной строки сходятся через файл, а не через общий код.
#
# Входные данные (фиксированы навсегда):
#   file_id                = 11 × 16
#   приватный ключ устройства = 5e × 32  (тот же, что у seal.kat; не выписан)
#   device_fpr             = публичный ключ этого устройства (при kem_id = 1 это одно и то же)
#   lease.seq              = 0x0102030405060708  (не ноль: ноль не поймал бы порядок байт)
#   claim                  = 44 × 32  (как в derivations.kat)
#   secret_A               = a1 × 32, secret_B = b2 × 32
#   aad доли A             = 9d × 32  (policy_hash, как у seal.kat)
#   aad доли B             = device_fpr

device_fpr = 33202f87ce4ff20cbcd0f2e48c8c7f263d11a3609c673b8c7eae56653769c12f

# K12: HKDF(salt=пусто, ikm=секрет устройства, info="CC/v1/cached-lease") — ключ
# MAC свидетеля состояния доступа. Вектора у K12 не было, а спека его однажды
# уже описывала неверно (исправление 2026-08-25): вектор закрепляет исправленное.
k12_witness_key = a55c1a15886373f99828cfdd290777d41c1f59a0bfdcfbcb609fcc02983ae58e

# K22: HKDF(salt=file_id, ikm=claim, info="CC/v1/claim-device") — приватный ключ
# X25519 наследника по коду, и его публичный ключ (он же отпечаток).
k22_claim_device_secret = 84e1c61f8ace25d6724be80d86973c6ac9a6911663d46050ffebbed4452b949c
k22_claim_device_public = 79fa05bc99f4f7e41211d5c520b966da0969ee48cad63ac39fcbbf08f70c1106

# K11: запечатывание сервер→устройство (доля A). Как seal.kat — вектор ОТКРЫТИЯ.
# info = "CC/v1/a-to-device" ‖ u8(kem_id) ‖ file_id ‖ device_fpr ‖ u64be(lease.seq).
# Разбор строки:
#   53532f76312f612d746f2d646576696365   "CC/v1/a-to-device" (17 байт)
#   01                                   kem_id = 1
#   1111…11                              file_id (16)
#   3320…2f                              device_fpr (32)
#   0102030405060708                     lease.seq, старшим байтом вперёд
k11_info = 43432f76312f612d746f2d646576696365011111111111111111111111111111111133202f87ce4ff20cbcd0f2e48c8c7f263d11a3609c673b8c7eae56653769c12f0102030405060708
k11_enc = 092c45f10eb6225ee3bb0801513332e19f2e68fe68cd9a72ea2558c22a905054
k11_nonce = 802d95c3358ce7fac182a2babf32e7ed09a944b535a9fe22
k11_ct = dcb1eebdc963a53c74b184983f15655bc3db21743f3fdda12e07b888329d936bc40f32ff3d645d98b300fc879ace575b
k11_plaintext = a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1

# K21: запечатывание автор→устройство (доля B). Номера лизинга в info НЕТ.
# info = "CC/v1/b-to-device" ‖ u8(kem_id) ‖ file_id ‖ device_fpr.
k21_info = 43432f76312f622d746f2d646576696365011111111111111111111111111111111133202f87ce4ff20cbcd0f2e48c8c7f263d11a3609c673b8c7eae56653769c12f
k21_enc = adb4100ecc338a26c6678a4fe81c712d8e4dd798ab5430f8d18bca6e9d5c4c25
k21_nonce = c1c144f5012a4e13b179c58a383b92e8a5b7bd147e95a34b
k21_ct = 9086752c5b96c7976cf8db9babfdf01edadf5ee9269704c32f6309e54e64850a463775bb38adb79e58c20cb22a0b77b8
k21_plaintext = b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2

# K23–K25: добавлено 2026-09-08; вызов c3 × 32, kind=3, тело 7a × 41.
k23_prove_echo = 141c16fc323769c4a7e3a5849f55adff9903fa8ea4ed069f2c5ccaf72d457a2a
k24_session_mac_key = 9476eb2394739d046c07cc1f54bd54f71ff0f8359c0f06355c1e90558ec88257
k25_request_mac = b182e1dc7730e25258ac036c65c83a68275e8ad03d0d8368e518912522ddc558

# K27: отпечаток устройства для механизмов, чей ключ длиннее 32 байт —
# SHA-256("CC/v1/device-fpr" ‖ 0x00 ‖ u8(kem_id) ‖ device_public).
# Решение 2026-09-09, docs/format.md, версия 5, «Отпечаток устройства».
# ДОБАВЛЕНО, не перевыпущено: И-14 запрещает менять замороженное, не заводить
# новое. Для X25519 отпечаток и есть ключ — строка device_fpr выше, без хеша.
#
# Входы — те же фиксированные величины, что у остальных векторов провода:
#   P-256   — публичная точка из SEAL_RECIPIENT_SECRET (p256_recipient_public);
#   X-Wing  — публичный ключ из семени 4d × 32;
#   MLKEM768-P256 — семя 4d × 32 для ML-KEM и та же точка P-256.
device_fpr_p256 = e3e961311d5ea588a3242009733c99bc2ecdc1d0ef78cc31a527cdd43302e973
device_fpr_xwing = cfbde0829089204346aa9532fc838653c88446eaa5f56dd337b60ec3c6a41876
device_fpr_mlkem_p256 = c0e84ec581f1387780f4192ff26b8bf02835fdafcb574c1fd2ff717d844bde40
