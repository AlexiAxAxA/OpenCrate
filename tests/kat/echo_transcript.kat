# Эхо доказательства владения, привязанное к разговору — docs/format.md,
# раздел «ЭХО ПРИВЯЗАНО К РАЗГОВОРУ 2026-09-21», производная K31 (§3.5).
#
# ЗАМОРОЖЕНО 2026-09-21 тем же решением. Новым файлом, а не строками в
# derivations_wire.kat: там заморожена СТАРАЯ производная эха (k23_prove_echo),
# и И-14 запрещает её трогать — она остаётся зелёной и проверяет форму, которой
# протокол больше не пользуется.
#
# Вычислено НЕЗАВИСИМО от Rust — отдельным сценарием на hashlib/hmac по тексту
# спеки (склейка транскрипта, SHA-256 и HMAC руками), и только потом сверено с
# `oc_crypto::kdf::handshake_transcript` и `oc_crypto::kdf::echo_transcript`.
# Сверяется в crates/oc-crypto/tests/kat.rs, причём дважды: транскриптом,
# собранным в самой пробе из байтов, и функциями крейта. Вектор, сверяющий код
# с самим собой, не доказывает ничего.
#
#   транскрипт = "CC/v1/echo-transcript" ‖ 0x00 ‖
#                u32le(len(hello)) ‖ hello ‖ u32le(len(challenge)) ‖ challenge
#   handshake  = SHA-256(транскрипт)
#   эхо        = HMAC-SHA256(ключ = секрет вызова,
#                            "CC/v1/echo-transcript" ‖ device_fpr ‖ handshake)
#
# `hello` и `challenge` — СЫРЫЕ байты кадров (`вид ‖ тело`), как они прошли по
# проводу. Здесь они взяты постоянными байтами правдоподобной длины: вектор
# проверяет арифметику производной, а не кодировку сообщений — её держат пробы
# `oc-protocol`.
#
# Входы (фиксированы навсегда):
#   hello      = 11 × 71
#   challenge  = 22 × 137
#   device_fpr = 5f × 32
#   секрет     = 7a × 32 (один предъявленный ключ) и
#                7a × 32 ‖ 9d × 32 (две половины: классика и аппаратная)
#
# СДВИНУТАЯ ГРАНИЦА — контроль однозначности, и он здесь несущий. Пара
# (11 × 70, 11 ‖ 22 × 137) даёт ТОТ ЖЕ склеенный поток байтов, что и пара выше.
# Без длин в транскрипте хеш совпал бы, то есть противник переносил бы байты из
# приветствия в вызов, не меняя эха. Эта строка обязана отличаться от
# `k31_handshake`.

hello = 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111
challenge = 2222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222222
device_fpr = 5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f
secret_32 = 7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a
secret_64 = 7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a7a9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d9d
k31_handshake = 6f00e263084aa535b115bac567361d586e43bf931210040c31eb5cd7d44efec0
k31_handshake_shifted_boundary = 1abff7f07bfc63326ca6f1b699a17c67b8f68667b1877a246a7ba57b965dcb75
k31_echo_32 = 97c0117f3c97c649408bf682a872ae361708f750e8a50400492beca1dce76667
k31_echo_64 = e0267347d1a954077ed167a38a8e5593f2cbb387d64e6c09e35a3e6587a74124
