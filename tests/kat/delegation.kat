# Делегирование потомку: тело, ключ потомка и подпись двери-родителя —
# docs/agent-protocol/stage-1-door.md §3.2, и итог проверки цепочки — §3.3.
#
# ЗАМОРОЖЕНО вместе с грантом (agent_grant.kat); версии контейнера вектор не
# касается по той же причине.
#
# Проверяется тестом crates/oc-protocol/tests/agent_vectors.rs.
#
# ## Ключи
#
#   родитель — та же дверь, что в agent_grant.kat: приватный ключ подписи d0 x 32,
#   согласовательный ключ d1 x 32.
#   приватный ключ подписи потомка = c0 x 32 (не выписан: это ключ)
#   согласовательный ключ потомка = c1 x 32; он же отпечаток (K27, X25519).
child_verify = 5b9437adeaffbe8f41b13d96ed49d2f51cd6c266cd8ecc284b0552ec4912b8dd

# ТЕЛО. Реестр тегов у делегирования СВОЙ, а не общий с грантом: состав полей
# другой, и тег, означающий в одном документе «ключ автора», а в другом
# «глубина», — приглашение перепутать их при чтении.
#
#   0100 10000000 67x16                корень цепочки (тот же grant_id)
#   0200 20000000 d1x32                кто делегирует: отпечаток родителя
#   0300 20000000 c1x32                отпечаток двери потомка
#   0400 01000000 01                   механизм потомка: 1 = X25519
#   0500 20000000 c1x32                согласовательный ключ потомка
#   0600 20000000 <child_verify>       ключ Ed25519 потомка
#   0700 96000000 <записи>             ПОДМНОЖЕСТВО списка родителя, одна запись
#                                      с file_id = 0001 00.., доля набита 44
#   0800 08000000 50b4546500000000     expires_at = 1700050000 (короче
#                                      родительского 1700086400)
#   0a00 01000000 01                   depth = 1: столько звеньев разрешено НИЖЕ
#
# Раскладка записи списка — та же, что в agent_grant.kat.
#
# Ужесточения (тег 9) нет и здесь. Отношение «не слабее родительского» в чистой
# функции НЕ проверяется вовсе: цепочка отдаёт ВСЕ ужесточения, а решатель
# пересекает их все. `intersect` монотонна только в сторону ужесточения, поэтому
# лишнее звено способно ужесточить и неспособно ослабить — проверки, которой
# нет, нельзя обойти.
delegation_body = 

# ПОДПИСЬ. Ed25519 над транскриптом "CC/v1/delegation" ‖ 0x00 ‖ поле(тело),
# ключом door_verify РОДИТЕЛЯ (он выписан в agent_grant.kat).
#
# Метка своя, а не "CC/v1/agent-grant": грант подписывает автор, делегирование —
# дверь своим эфемерным ключом. Совпади домены — дверь, получившая грант,
# выписала бы себе новый, то есть новую глубину и новый срок.
delegation_signature = 6f2791474defcd70d02e583941abda12c25dbbd4344d15120b2e64989582462e6ec4e6ec7ee60c7f76b28c2e9e649caf7eced41fffa344a6d937e566c549670e

# ИТОГ ПРОВЕРКИ ЦЕПОЧКИ «грант + это звено» в названный момент. Часы —
# ПАРАМЕТРОМ, а не из системы: проба на истечение обязана быть данными, иначе
# она проверяет часы машины, а не правило.
chain_now = 1700010000
chain_holder_fpr = c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1
chain_holder_verify = 5b9437adeaffbe8f41b13d96ed49d2f51cd6c266cd8ecc284b0552ec4912b8dd
chain_file = 00010000000000000000000000000000
