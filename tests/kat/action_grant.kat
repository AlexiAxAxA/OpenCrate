# Грант ДЕЙСТВИЙ: тело, ключ автора и подпись — docs/agent-protocol/stage-2-actions.md §4.1.
#
# ЗАМОРОЖЕНО вместе с выпуском документа Agent Protocol этапа 2. Версии
# КОНТЕЙНЕРА вектор не касается: ни один его байт в .cc не лежит, и заголовок о
# гранте действий не знает. Заморожен он версией СВОЕГО документа — тем же
# порядком, что lease.kat и agent_grant.kat.
#
# Проверяется тестом crates/oc-protocol/tests/action_vectors.rs.
#
# ## Почему заморожена подпись, а не только тело
#
# Тело само по себе ничего не значит: грант действий — утверждение АВТОРА, и без
# подписи он лист бумаги. Заморозив только байты тела, мы оставили бы на свободе
# транскрипт — то, ЧТО именно подписано, — а расхождение там молчаливо: подпись
# просто не сойдётся, и выглядеть это будет как «сервер сломался».
#
# ## Ключи
#
#   приватный ключ автора = a1 x 32 (не выписан: это ключ, а не значение на проводе)
author_key = bc7cbcb5636375fa1d82434d466724d92377f53b980695dd49d26d0ce12205a5

# ТЕЛО. TLV, теги строго по возрастанию (И-7), длины точные (И-8). По полям:
#
#   0100 10000000 67x16                имя ФАЙЛОВОГО гранта, к которому привязан
#                                      грант действий: тот же держатель, тот же
#                                      потолок срока, то же погашение. Цепочка
#                                      одна, второй сущности отзыва нет
#   0200 b2000000 <правила>             список правил, см. ниже
#   0300 08000000 00f1536500000000     issued_at  = 1700000000
#   0400 08000000 8042556500000000     expires_at = 1700086400
#   0500 20000000 <author_key>         ключ автора
#
# СПИСОК ПРАВИЛ (тег 2) — вложенный TLV с нумерацией ПОЗИЦИЕЙ, тем же приёмом,
# каким заголовок кодирует слоты, а грант агента — файлы. Своего счётчика нет
# намеренно: он был бы вторым источником истины о длине.
#
# Правило с номером i:
#
#   <i>  <len> <тело правила>
#        0100 02000000 вид             u16le из реестра ActionKind
#        0200 <len>    ограничитель    вложенный TLV, состав тегов ЗАВИСИТ ОТ ВИДА
#        0300 04000000 max_uses        u32le; 0 — без предела
#        0400 01000000 confirm         ровно 0 или 1
#        0500 01000000 delegable       ровно 0 или 1
#
# Здесь правил два.
#
# ПРАВИЛО 0 — git.push (вид 1), remote = "origin", branch = "agent/work",
# max_uses = 10, confirm = 0, delegable = 1. Ограничитель:
#
#        0100 06000000 "origin"        remote, равенство
#        0200 0a000000 "agent/work"    branch, равенство
#
# Поля под `--force` НЕТ, и это не упущение: оно невыразимо по построению.
# Аргументы с дописанным критичным тегом отвергаются на разборе, а необязательный
# тег до исполнителя не доходит — он читает структуру, а не байты.
#
# ПРАВИЛО 1 — http.request (вид 4), host = "api.example.com", методы GET и POST
# (01 03, строго по возрастанию), path_prefix = "/v1/issues",
# secret_ref = "FORGE_TOKEN", max_uses = 0 (без предела), confirm = 1,
# delegable = 0. Ограничитель:
#
#        0600 0f000000 "api.example.com"  хост точно; маска невыразима — «*» не
#                                         входит в набор допустимых байтов
#        0700 02000000 0103               методы: по байту на метод
#        0800 0a000000 "/v1/issues"       префикс пути, сравнение ПО КОМПОНЕНТАМ
#        0900 0b000000 "FORGE_TOKEN"      имя ссылки на секрет в окружении ДВЕРИ;
#                                         значения секрета здесь нет и не будет
#
# Реестр тегов ограничителя и аргументов ОДИН: аргументы идут теми же номерами,
# что ограничители, и виды пользуются непересекающимися подмножествами. Тег,
# которого этот вид не ждёт, — незнакомый критичный тег, даже если соседний вид
# его знает.
grant_body = 

# ПОДПИСЬ. Ed25519 над транскриптом "CC/v1/action-grant" ‖ 0x00 ‖ поле(тело).
#
# Метка своя, а не "CC/v1/agent-grant": та раздаёт доли B на ЧТЕНИЕ поддерева, а
# эта раздаёт право ДЕЙСТВОВАТЬ снаружи клетки. Совпади домены — подпись автора
# под открытым каталогом годилась бы подписью под `git push` (И-12).
#
# Проверка — verify_strict, как у заголовка (И-6), и ДО разбора тела (И-5).
grant_signature = c2560f54fb206098674960db11244a689ec50303525f3da12458dcdcbfc73a47d40a323b135b005c299c973b245d5e8631be827c59ed69cf69e1efd186038804
