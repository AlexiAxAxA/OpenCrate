# Грант агента: тело, ключи и подпись автора — docs/agent-protocol/stage-1-door.md §3.1.
#
# ЗАМОРОЖЕНО вместе с выпуском документа Agent Protocol этапа 1. Версии
# КОНТЕЙНЕРА вектор не касается: ни один его байт в .cc не лежит, и заголовок о
# гранте не знает. Заморожен он версией СВОЕГО документа — тем же порядком, что
# lease.kat и journal.kat.
#
# Проверяется тестом crates/oc-protocol/tests/agent_vectors.rs.
#
# ## Почему заморожена подпись, а не только тело
#
# Тело само по себе ничего не значит: грант — это утверждение АВТОРА, и без
# подписи он лист бумаги. Заморозив только байты тела, мы оставили бы на свободе
# транскрипт — то, ЧТО именно подписано, — а расхождение там молчаливо: подпись
# просто не сойдётся, и выглядеть это будет как «сервер сломался».
#
# ## Ключи
#
#   приватный ключ автора = a1 x 32 (не выписан: это ключ, а не значение на проводе)
#   приватный ключ подписи двери = d0 x 32 (не выписан, там же)
#   согласовательный ключ двери = d1 x 32; у X25519 отпечаток И ЕСТЬ ключ (K27),
#   поэтому door_fpr совпадает с ним байт в байт.
author_key = bc7cbcb5636375fa1d82434d466724d92377f53b980695dd49d26d0ce12205a5
door_verify = e72c28fe718e3a30afc47438da779d508d2dad5a265fafeb4f377e1d57fb098c

# ТЕЛО. TLV, теги строго по возрастанию (И-7), длины точные (И-8). По полям:
#
#   0100 10000000 67x16                имя гранта (grant_id)
#   0200 20000000 d1x32                отпечаток согласовательного ключа двери
#   0300 01000000 01                   механизм двери: 1 = X25519. Иной номер
#                                      этап 1 отвергает НА РАЗБОРЕ
#   0400 20000000 d1x32                согласовательный ключ двери
#   0500 20000000 <door_verify>        ключ Ed25519 двери: им дверь подписывает
#                                      делегирования
#   0600 2c010000 <записи>             список файлов, см. ниже
#   0700 08000000 00f1536500000000     issued_at  = 1700000000
#   0800 08000000 8042556500000000     expires_at = 1700086400
#   0a00 01000000 02                   max_depth = 2
#   0b00 20000000 <author_key>         ключ автора
#
# Тега 9 (ужесточение политики) здесь НЕТ, и это значение: «грант не ужесточает
# ничего». Поле необязательное; когда оно есть, внутри лежат байты того же
# кодека политики, каким кодируется профиль сервера в лизинге, — второй формы
# политики на проводе быть не должно.
#
# СПИСОК ФАЙЛОВ (тег 6) — вложенный TLV с нумерацией ПОЗИЦИЕЙ, тем же приёмом,
# каким заголовок кодирует слоты (запись 10). Своего счётчика записей нет
# намеренно: он был бы вторым источником истины о длине и разошёлся бы с телом.
# Запись с номером i:
#
#   <i>  90000000 <тело записи>
#        0100 10000000 file_id(16)
#        0200 20000000 enc     — эфемерная половина запечатывания доли B
#        0300 18000000 nonce(24)
#        0400 30000000 ct      — сама доля B под ключом двери
#
# Здесь записи две: file_id = 0001 00.. и 0002 00.., доли набиты 11 и 22.
# Порядок по возрастанию file_id НОРМАТИВЕН и проверяется на разборе: из него
# бесплатно следует, что повтор невозможен, перестановка невозможна и один набор
# файлов — одна последовательность байтов.
grant_body = 

# ПОДПИСЬ. Ed25519 над транскриптом "CC/v1/agent-grant" ‖ 0x00 ‖ поле(тело).
#
# Метка своя, а не "CC/v1/grant": та помечает одобрение автора по ОДНОЙ просьбе
# об одном файле, и совпади домены — подпись под одобрением одного файла
# годилась бы подписью под раздачей целого поддерева (И-12).
#
# Проверка — verify_strict, как у заголовка (И-6), и ДО разбора тела (И-5).
grant_signature = 38210534b154b3efca545d40e93b1466a46299f773819836f0d61c178ad2377ab124837e666a5ac01eba488f4a000d9cef3367641b705ffda4dfce27d95f5b0c
