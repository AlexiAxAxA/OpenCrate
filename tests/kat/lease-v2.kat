# Лизинг ВЕРСИИ 2: тело, подпись и ключ проверки — docs/protocol.md §2.3.
#
# ЗАМОРОЖЕНО вместе с выпуском документа лизинга версии 2 (2026-09-16, B4a).
#
# ## Почему отдельный файл, а не строки в lease.kat
#
# Потому что lease.kat заморожен вместе с документом версии 1 и меняться не
# вправе (И-14). Версия 2 — ДРУГОЙ документ: она несёт тег 12 (профиль сервера),
# а документ без профиля по-прежнему выпускается версией 1 и сходится со старым
# вектором байт в байт. Два свидетеля рядом, а не один перевыпущенный: добавление
# свидетеля — не перевыпуск.
#
# Проверяется тестом crates/oc-format/tests/lease_server_policy.rs.
#
# ## Вход
#
#   приватный ключ сервера = 5a × 32 (не выписан: это ключ, а не значение на проводе)
#   профиль сервера: смотреть можно, остальное нельзя; привязка не ниже
#   аппаратной; не больше 3 открытий; лизинг не длиннее 3600 с, офлайн не дольше
#   600 с; водяного знака не требует; своего окна действия не ставит.
lease_verify_key = 0d7550754e0800a5d237eef5826035766b9b3e5a15868a940ab289958788e3b0

# ТЕЛО. TLV, теги строго по возрастанию, разбор по §2.3. Раскладка по полям:
#   0100 02000000 0200                версия = 2
#   0200 10000000 11×16               file_id
#   0300 20000000 22×32               отпечаток устройства
#   0400 20000000 33×32               policy_hash
#   0500 08000000 0700000000000000     seq = 7
#   0600 08000000 0200000000000000     epoch = 2
#   0700 08000000 00f1536500000000     issued_at = 1700000000
#   0800 08000000 8042556500000000     expires_at = 1700086400
#   0900 01000000 01                   состояние = действует
#   0a00 04000000 05000000             остаток открытий = 5
#   0b00 0c000000 03000000 40e2010000000000   часы TPM: сброс 3, 123456 мс
#   0c00 96000000 …                    профиль сервера, кодек политики §4 формата
#
# Порядок последних двух полей существен и проверяется пробой: у часов тег 11, у
# профиля 12, и писатель, поставивший профиль раньше, получил бы отказ от самого
# TlvWriter (И-7) — то есть лизинг с часами перестал бы выпускаться вовсе.
lease_body = 

# ПРОФИЛЬ ОТДЕЛЬНО — те же байты, что стоят значением тега 12. Выписан затем,
# чтобы вторая реализация могла сверить кодек политики, не вырезая его из тела.
server_policy = 

# ПОДПИСЬ. Ed25519 над транскриптом "CC/v1/lease" ‖ 0x00 ‖ поле(тело).
#
# Метка та же, что у версии 1, и это намеренно: подписывается ДОКУМЕНТ ЛИЗИНГА, а
# версия — его поле, покрытое подписью наравне с остальными. Отдельная метка на
# версию означала бы, что две версии подписаны разными транскриптами, и перенос
# подписи между ними стал бы вопросом метки, а не поля.
lease_signature = 607bd45a36e20fd528c04ab7305fa329c4034adde29cf32b378db8f0aefbc761266c07b85e42670bb24a75da64b43a98292887744ae6ebff88863994b84e3306
