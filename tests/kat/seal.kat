# Запечатывание слота (K10) и связанные данные — docs/format.md §3.3, §3.5, §2.0.
#
# ЗАМОРОЖЕНО, см. derivations.kat.
#
# Проверяется тестом crates/oc-crypto/tests/kat.rs.
#
# ## Почему это вектор ОТКРЫТИЯ, а не запечатывания
#
# Запечатывание случайно по построению: эфемерная пара берётся из генератора, nonce
# выводится из засева (§3.1). Воспроизвести те же байты вторая реализация не может и
# не должна — требовать этого значило бы заморозить наш генератор, а не формат.
#
# Открытие детерминировано полностью, и именно его выполняет всякий, кто читает
# контейнер: сервер открывает свой слот, получатель — свой. Поэтому вектор говорит:
# «вот приватный ключ, вот блоб, вот info и aad — ты обязан получить ровно этот
# открытый текст». Одна проверка покрывает всю конструкцию: согласование X25519,
# вывод ключа K10 вместе с его info, разбор ХРАНИМОГО nonce и AEAD со связанными
# данными.
#
# Отдельного вектора на промежуточный ключ K10 здесь намеренно нет: он заморозил бы
# внутренность, которую реализация вправе считать иначе, лишь бы результат совпал.

# ВХОД.
#   приватный ключ получателя = 5e × 32   (не выписан отдельной строкой: это ключ,
#                                          а не значение на проводе; см. тест)
#   file_id                   = 11 × 16
#   aad                       = 9d × 32   (по формату это policy_hash)
recipient_public = 33202f87ce4ff20cbcd0f2e48c8c7f263d11a3609c673b8c7eae56653769c12f

# info запечатывания: метка назначения ‖ u8(kem_id) ‖ file_id.
#
# Заморожено отдельно, потому что расхождение здесь молчаливо: ключ разойдётся, а
# выглядеть это будет как «слот не открывается, файл повреждён». Разбор строки:
#   53532f76312f736c6f742d736572766572   "CC/v1/slot-server"  (17 байт)
#   01                                   kem_id = 1 (X25519+HKDF-SHA256)
#   1111…11                              file_id (16 байт)
slot_info_server = 43432f76312f736c6f742d7365727665720111111111111111111111111111111111

# Связанные данные приватных метаданных: "CC/v1/private-meta" ‖ file_id (34 байта).
#
# Соседнее нормативное значение того же класса. У AAD чанка вектор был с самого
# начала (chunk_aad.kat), у этого не было — и в спеке он тоже не был выписан ни
# строкой, пока это не нашёл второй раунд ревью (пункт Р-13).
metadata_aad = 43432f76312f707269766174652d6d65746111111111111111111111111111111111

# БЛОБ. Раскладка записи слота: enc(32) ‖ nonce(24) ‖ ct(шифротекст с тегом).
seal_enc = 42707167c924e931d8e19c8bf64f9afbb3e4585799416ba5b4d6cb2748a57978
seal_nonce = 7d2880ca9bf726788c2aff742b62da039b32bbd027224ee6
seal_ct = 53b5f921720ba5296c7c3a7a33739edb989a358565d48ccceea924af105420fba222296e94a529c4ad567079c692b497

# ВЫХОД: то, что обязано получиться при открытии. Здесь это доля secret_A из
# derivations.kat — слот сервера несёт именно её.
seal_plaintext = a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1
